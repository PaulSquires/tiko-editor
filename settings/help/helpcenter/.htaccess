<IfModule mod_headers.c>
    # Documents, data and code must revalidate. Without this the host's week-long default
    # leaves returning visitors on a stale sidebar or a stale search index after an
    # update. "no-cache" still caches — it just asks first, and an unchanged file comes
    # back as a 304 with no body.
    <FilesMatch "\.(html|js|css|json|xml)$">
        Header set Cache-Control "no-cache, must-revalidate"
        # The host also emits a week-ahead Expires; left in place, some caches honour it
        # over Cache-Control and never revalidate. Remove it so no-cache actually bites.
        Header unset Expires
        Header unset Pragma
    </FilesMatch>

    # Media is content, not plumbing — safe to cache hard.
    <FilesMatch "\.(png|jpe?g|gif|svg|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

ErrorDocument 404 /docs/404.html
