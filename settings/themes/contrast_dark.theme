general.description: High Contrast Dark
general.version: 1.0.0
general.appearance: dark

# High Contrast Dark -- palette after a high-contrast palette for tiko
# Re-implemented for tiko from published colour values; no files from the
# original project are included or derived.
#
# A ROLES-ONLY THEME. Every widget key inherits from the palette below, so a
# key added to tiko later is themed here for free instead of coming up in
# some other palette's colours. To depart from the palette, name the key
# itself -- an explicit value always beats its role.

role.background: 0,0,0
role.backgroundalt: 16,16,16
role.backgroundraised: 16,16,16
role.foreground: 255,255,255
role.foregrounddim: 190,190,190
role.border: 110,110,110
role.accent: 0,60,140
role.accentfore: 120,190,255
role.hot: 45,45,45
role.selection: 0,80,170
role.error: 255,110,110
role.warning: 255,220,100
role.success: 120,240,120
role.keyword: 120,190,255
role.apikeyword: 120,240,220
role.userkeyword: 255,220,100
role.comment: 170,215,170
role.string: 255,190,140
role.number: 200,255,180
role.operator: 255,255,255
role.preprocessor: 230,160,255

