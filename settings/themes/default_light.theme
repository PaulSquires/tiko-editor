general.description: Default (Light) Theme
general.version: 1.0.0

# all colors are specified using RGB syntax (red,green,blue)


# ---------------------------------------------------------------------------------------
# THE ROLE PALETTE
#
# Every widget key falls back to one of these when this file does not name it, so a key
# added to tiko later is themed here for free instead of arriving as a built-in default
# from some other palette -- which for a LIGHT theme would mean inheriting tiko's dark
# defaults. Values below are this theme's own colours, not new ones.
#
# Resolution order:  the key itself  ->  its role  ->  tiko's built-in default
# ---------------------------------------------------------------------------------------
role.background: 255,255,255
role.backgroundalt: 243,243,243
role.backgroundraised: 255,255,255
role.foreground: 97,97,97
role.foregrounddim: 157,165,180
role.border: 221,221,221
role.accent: 204,233,252
# The accent as readable INK (glyphs, ticks, focus rings) rather than as a fill.
role.accentfore: 0,102,184
role.hot: 229,229,229
role.selection: 173,214,255
role.error: 196,0,0
role.warning: 198,106,12
role.success: 0,128,0
role.keyword: 0,0,255
role.apikeyword: 187,111,78
role.userkeyword: 179,48,142
role.comment: 0,128,0
role.string: 163,21,21
role.number: 198,107,60
role.operator: 196,0,0
role.preprocessor: 165,134,181

compile.iconsuccess.foreground: 138,209,138  # green
compile.iconfail.foreground: 255,0,0         # red
output.valuechanged.foreground: 198,106,012  # soft orange - a debugger value that changed on the last step

main.panel.background: 255,255,255

editor.caret.foreground: 0,0,0
editor.currentline.background: 255,255,0    # yellow
editor.text.foreground: 0,0,0
editor.text.background: 255,255,255
editor.text.bold: false
editor.text.italic: false
editor.text.underline: false
editor.numbers.foreground: 0,0,0
editor.numbers.background: 255,255,255
editor.numbers.bold: false
editor.numbers.italic: false
editor.numbers.underline: false
editor.comments.foreground: 0,128,0        # green
editor.comments.background: 255,255,255
editor.comments.bold: false
editor.comments.italic: false
editor.comments.underline: false
editor.keyword.foreground: 0,0,255          # blue
editor.keyword.background: 255,255,255
editor.keyword.bold: false
editor.keyword.italic: false
editor.keyword.underline: false
editor.keyword2.foreground: 187,111,78      # Windows Api (dark orange)
editor.keyword2.background: 255,255,255
editor.keyword2.bold: false
editor.keyword2.italic: false
editor.keyword2.underline: false
editor.keyword3.foreground: 179,48,142         # Extra Keywords (pink)
editor.keyword3.background: 255,255,255
editor.keyword3.bold: false
editor.keyword3.italic: false
editor.keyword3.underline: false
editor.foldmargin.foreground: 255,255,255
editor.foldsymbol.foreground: 157,165,180
editor.foldsymbol.background: 255,255,255
editor.linenumbers.foreground: 157,165,180
editor.linenumbers.background: 255,255,255
editor.linenumbers.bold: false
editor.linenumbers.italic: false
editor.linenumbers.underline: false
editor.operators.foreground: 196,0,0            # red
editor.operators.background: 255,255,255
editor.operators.bold: false
editor.operators.italic: false
editor.operators.underline: false
editor.indentguides.foreground: 255,255,255
editor.indentguides.background: 0,0,0
editor.preprocessor.foreground: 165,134,181    # light purple
editor.preprocessor.background: 255,255,255
editor.preprocessor.bold: false
editor.preprocessor.italic: false
editor.preprocessor.underline: false
editor.selection.foreground: 255,255,255
editor.selection.background: 173,214,255       # light blue
editor.strings.foreground: 173,0,173           # Purple (little darker than Magenta)
editor.strings.background: 255,255,255
editor.strings.bold: false
editor.strings.italic: false
editor.strings.underline: false
editor.bracegood.foreground: 000,128,000       # green
editor.bracebad.foreground: 196,000,000        # red
editor.occurrence.foreground: 148,202,240      # powder blue
editor.scrollbar.foreground: 221,221,221
editor.scrollbar.background: 255,255,255
editor.divider.foreground: 221,221,221
editor.bookmark.foreground: 0,0,0
editor.bookmark.background: 255,255,255
editor.breakpoint.foreground: 196,68,80        # crimson
editor.breakpoint.background: 196,68,80        # crimson
editor.debugline.foreground: 0,0,250           # blue
editor.debugline.background: 0,0,250           # blue

